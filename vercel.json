{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm exec next build",
  "ignoreCommand": "test -n \"$VERCEL_GIT_PREVIOUS_SHA\" && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" \"${VERCEL_GIT_COMMIT_SHA:-HEAD}\" -- . ':(exclude)vyta-runtime/**' ':(exclude)railway-preview/**'",
  "alias": [
    "www.maksteratelier.com",
    "maksteratelier.com"
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "maksteratelier.com"
        }
      ],
      "destination": "https://www.maksteratelier.com/:path*",
      "permanent": true
    }
  ]
}
