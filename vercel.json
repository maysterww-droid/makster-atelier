{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm exec next build",
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_MESSAGE\" in *\"(vyta-runtime)\"*|*\"(railway-preview)\"*) exit 0 ;; *) exit 1 ;; esac",
  "alias": [
    "www.maksteratelier.com",
    "maksteratelier.com"
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "maksteratelier.com"
        }
      ],
      "destination": "https://www.maksteratelier.com/:path*",
      "permanent": true
    }
  ]
}
