NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase service role. Required only for trusted server jobs/webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public URL used to build client quote links and billing redirects,
# e.g. https://app.quote.maksteratelier.com
NEXT_PUBLIC_APP_URL=

# Server-only email delivery. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
QUOTE_EMAIL_FROM=

# Server-only Stripe Managed Payments billing. Never prefix with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Canonical Makster Quote paid plans.
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_WORKSHOP_MONTHLY_PRICE_ID=
STRIPE_ATELIER_MONTHLY_PRICE_ID=

# Legacy sandbox compatibility only. Do not configure these for new checkout sessions.
# STRIPE_PRO_MONTHLY_PRICE_ID=
# STRIPE_FOUNDER_MONTHLY_PRICE_ID=
