NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase service role. Required only for trusted server jobs/webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public URL used to build client quote links and billing redirects,
# e.g. https://quote.example.com
NEXT_PUBLIC_APP_URL=

# Server-only email delivery (MQ 0.1.5). Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
QUOTE_EMAIL_FROM=

# Server-only Lemon Squeezy billing (MQ 0.1.6). Never prefix these with NEXT_PUBLIC_.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_TEST_MODE=true
LEMONSQUEEZY_VARIANT_FOUNDER=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_WORKSHOP=
