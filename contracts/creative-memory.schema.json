{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creative-memory.schema.json",
  "title": "CreativeMemoryEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "brand_id", "project_id", "kind", "timestamp"],
  "properties": {
    "id": {"type": "string"},
    "brand_id": {"enum": ["MAKSTER_ATELIER", "VYTA"]},
    "project_id": {"type": "string"},
    "shot_id": {"type": ["string", "null"]},
    "take_id": {"type": ["string", "null"]},
    "kind": {"enum": ["APPROVED", "REJECTED", "PREFERENCE", "QA_FAILURE", "PERFORMANCE", "COST"]},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "note": {"type": ["string", "null"]},
    "metrics": {"type": "object"},
    "timestamp": {"type": "string", "format": "date-time"}
  }
}
