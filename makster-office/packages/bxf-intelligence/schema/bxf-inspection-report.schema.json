{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://makster.ai/schemas/bxf-inspection-report-0.6.0.json",
  "title": "Makster BXF Inspection Report 0.6.0",
  "type": "object",
  "required": ["parserVersion","fileName","byteLength","sha256","namespaceUris","status","candidateSkus","candidateDrillings","warnings"],
  "properties": {
    "parserVersion": { "const": "0.6.0" },
    "fileName": { "type": "string", "minLength": 1 },
    "byteLength": { "type": "integer", "minimum": 0, "maximum": 5242880 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rootElement": { "type": "string" },
    "namespaceUris": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "schemaFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "enum": ["recognized","inspection_only","rejected"] },
    "candidateSkus": { "type": "array" },
    "candidateDrillings": { "type": "array" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "adapter": {
      "type": "object",
      "required": ["adapterId","recognized","hardwareCodes","manufacturingProfiles","warnings"],
      "properties": {
        "adapterId": { "type": "string" },
        "recognized": { "type": "boolean" },
        "manufacturer": { "const": "Blum" },
        "schemaVersion": { "type": "string" },
        "projectReference": { "type": "string" },
        "hardwareCodes": { "type": "array", "items": { "type": "string" } },
        "manufacturingProfiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["manufacturer","hardwareCode","profileKind","catalogVersion","sourceKind","sourceChecksumSha256","sourceSchemaFingerprint","adapterId","verified","holes"],
            "properties": {
              "manufacturer": { "const": "Blum" },
              "hardwareCode": { "type": "string" },
              "profileKind": { "const": "runner_cabinet_drilling" },
              "catalogVersion": { "type": "string" },
              "sourceKind": { "enum": ["manufacturer_bxf","fixture_only"] },
              "sourceChecksumSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "sourceSchemaFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "adapterId": { "type": "string" },
              "verified": { "type": "boolean" },
              "holes": { "type": "array", "minItems": 1 }
            },
            "additionalProperties": true
          }
        },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
