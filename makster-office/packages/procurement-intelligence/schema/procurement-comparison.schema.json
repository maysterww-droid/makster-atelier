{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://makster.ai/schema/procurement-comparison-1.2.json",
  "title": "Makster Procurement Comparison 1.2",
  "type": "object",
  "required": ["procurementVersion","comparisonId","rfqId","strategy","weights","generatedAt","ranking"],
  "properties": {
    "procurementVersion": {"const":"1.2.0"},
    "comparisonId": {"type":"string","minLength":1},
    "rfqId": {"type":"string","minLength":1},
    "strategy": {"enum":["balanced","cheapest","fastest","quality_first"]},
    "weights": {
      "type":"object",
      "required":["price","leadTime","quality","serviceFit","logistics"],
      "properties": {
        "price":{"type":"number","minimum":0,"maximum":1},
        "leadTime":{"type":"number","minimum":0,"maximum":1},
        "quality":{"type":"number","minimum":0,"maximum":1},
        "serviceFit":{"type":"number","minimum":0,"maximum":1},
        "logistics":{"type":"number","minimum":0,"maximum":1}
      },
      "additionalProperties":false
    },
    "generatedAt":{"type":"string"},
    "recommendedQuoteId":{"type":"string"},
    "ranking": {
      "type":"array",
      "items": {
        "type":"object",
        "required":["quoteId","supplierId","supplierName","strategy","totalScore","components","facts","warnings","eligible"],
        "properties": {
          "quoteId":{"type":"string"},"supplierId":{"type":"string"},"supplierName":{"type":"string"},
          "strategy":{"type":"string"},"totalScore":{"type":"number","minimum":0,"maximum":100},
          "components":{"type":"object"},"facts":{"type":"object"},"warnings":{"type":"array","items":{"type":"string"}},"eligible":{"type":"boolean"}
        },
        "additionalProperties":true
      }
    }
  },
  "additionalProperties":false
}
