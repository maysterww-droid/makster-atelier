{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://makster.ai/schema/parsed-supplier-reply-1.3.json",
  "title": "Makster Parsed Supplier Reply 1.3",
  "type": "object",
  "required": [
    "communicationVersion",
    "classification",
    "missingFields",
    "warnings",
    "rawTextSha256"
  ],
  "properties": {
    "communicationVersion": {
      "const": "1.3.0"
    },
    "classification": {
      "enum": [
        "quote_candidate",
        "declined",
        "needs_review"
      ]
    },
    "rfqId": {
      "type": "string"
    },
    "supplierId": {
      "type": "string"
    },
    "responseToken": {
      "type": "string"
    },
    "quote": {
      "type": "object"
    },
    "missingFields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rawTextSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
