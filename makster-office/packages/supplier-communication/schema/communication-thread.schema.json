{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://makster.ai/schema/supplier-communication-thread-1.3.json",
  "title":"Makster Supplier Communication Thread 1.3",
  "type":"object",
  "required":["communicationVersion","threadId","rfqId","projectId","revision","supplierId","supplierName","supplierEmail","provider","status","subject","responseToken","createdAt","reminderCount"],
  "properties":{
    "communicationVersion":{"const":"1.3.0"},
    "threadId":{"type":"string","minLength":1},
    "rfqId":{"type":"string","minLength":1},
    "projectId":{"type":"string","minLength":1},
    "revision":{"type":"integer","minimum":1},
    "supplierId":{"type":"string","minLength":1},
    "supplierName":{"type":"string","minLength":1},
    "supplierEmail":{"type":"string","pattern":"^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"},
    "provider":{"enum":["memory","gmail"]},
    "status":{"enum":["draft","sent","replied","declined","closed"]},
    "subject":{"type":"string"},
    "responseToken":{"type":"string","minLength":8},
    "providerThreadId":{"type":"string"},
    "providerRootRfcMessageId":{"type":"string"},
    "responseDeadline":{"type":"string","format":"date-time"},
    "createdAt":{"type":"string","format":"date-time"},
    "lastOutboundAt":{"type":"string","format":"date-time"},
    "lastInboundAt":{"type":"string","format":"date-time"},
    "reminderCount":{"type":"integer","minimum":0}
  },
  "additionalProperties":false
}
